'use client';

import { useState, useEffect, useCallback } from 'react';
import { X, CheckCircle2, Download, Loader2, Music, Film, Sparkles } from 'lucide-react';
import { useSiteSettings, SiteSettings } from '@/lib/settings-store';
import { executeDirectCdnDownload } from '@/lib/tiktok-client';
import AdSlot from './AdSlot';

interface DownloadCounterModalProps {
  isOpen: boolean;
  onClose: () => void;
  downloadUrl: string;
  fileName: string;
  mediaType: 'video' | 'audio' | 'avatar';
  title?: string;
}

function ModalContent({
  initialSeconds,
  downloadUrl,
  fileName,
  mediaType,
  title,
  onClose,
  settings,
}: {
  initialSeconds: number;
  downloadUrl: string;
  fileName: string;
  mediaType: 'video' | 'audio' | 'avatar';
  title?: string;
  onClose: () => void;
  settings: SiteSettings;
}) {
  const [counter, setCounter] = useState(initialSeconds);
  const [isReady, setIsReady] = useState(false);
  const [isDownloading, setIsDownloading] = useState(false);
  const [hasTriggeredDownload, setHasTriggeredDownload] = useState(false);
  const [downloadError, setDownloadError] = useState<string | null>(null);

  const runDownload = useCallback(async () => {
    if (!downloadUrl) return;
    setIsDownloading(true);
    setDownloadError(null);
    try {
      await executeDirectCdnDownload(downloadUrl, fileName);
      setHasTriggeredDownload(true);
    } catch (err: unknown) {
      setDownloadError(err instanceof Error ? err.message : 'Download failed. Please try again.');
    } finally {
      setIsDownloading(false);
    }
  }, [downloadUrl, fileName]);

  const handleManualDownloadClick = async () => {
    await runDownload();
  };

  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        onClose();
      }
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [onClose]);

  useEffect(() => {
    let current = initialSeconds;
    const timer = setInterval(() => {
      current -= 1;
      setCounter(current);

      if (current <= 0) {
        clearInterval(timer);
        setIsReady(true);
        if (downloadUrl) {
          void runDownload();
        }
      }
    }, 1000);

    return () => clearInterval(timer);
  }, [initialSeconds, downloadUrl, runDownload]);

  const progressPercent = Math.min(
    100,
    Math.round(((initialSeconds - counter) / initialSeconds) * 100)
  );

  return (
    <div
      onClick={(e) => e.stopPropagation()}
      className="relative w-full max-w-[400px] sm:max-w-[430px] h-[540px] sm:h-[580px] max-h-[90vh] bg-[#FFFFFF] rounded-2xl border border-[#CBD5DF] shadow-2xl flex flex-col justify-between overflow-hidden animate-in fade-in zoom-in-95 duration-200 select-none"
    >
      {/* High-Contrast Dark Header */}
      <div className="w-full bg-[#010101] text-[#FFFFFF] px-3.5 py-3 border-b border-[#2F363D] flex items-center justify-between gap-2.5 shrink-0">
        <div className="flex items-center gap-2 min-w-0">
          <div className="w-6 h-6 rounded-full bg-[#EE1D52]/20 border border-[#EE1D52]/50 flex items-center justify-center shrink-0">
            {mediaType === 'audio' ? (
              <Music className="w-3.5 h-3.5 text-[#69C9D0]" />
            ) : (
              <Film className="w-3.5 h-3.5 text-[#EE1D52]" />
            )}
          </div>
          <span className="text-xs sm:text-[13px] font-bold text-[#FFFFFF] truncate">
            {mediaType === 'audio' ? 'Clean Audio Downloader' : 'Watermark-Free HD Downloader'}
          </span>
        </div>

        <button
          type="button"
          onClick={onClose}
          className="w-7 h-7 rounded-full bg-[#FFFFFF]/15 hover:bg-[#EE1D52] text-[#FFFFFF] flex items-center justify-center transition-all active:scale-95 cursor-pointer shrink-0"
          aria-label="Close"
          title="Close and return to videos"
        >
          <X className="w-3.5 h-3.5" />
        </button>
      </div>

      {/* Center Body: Countdown OR Ready State */}
      <div className="w-full flex-1 min-h-0 flex flex-col items-center justify-center p-4 sm:p-5 text-center overflow-y-auto bg-[#FFFFFF]">
        {!isReady ? (
          <div className="flex flex-col items-center justify-center w-full max-w-sm">
            {/* Compact Circular Progress & Countdown Number */}
            <div className="relative w-28 h-28 sm:w-32 sm:h-32 mb-4 flex items-center justify-center">
              <svg className="w-full h-full -rotate-90" viewBox="0 0 100 100">
                <circle
                  cx="50"
                  cy="50"
                  r="42"
                  className="stroke-[#DFE5EA]"
                  strokeWidth="7"
                  fill="transparent"
                />
                <circle
                  cx="50"
                  cy="50"
                  r="42"
                  className="stroke-[#EE1D52] transition-all duration-1000 ease-linear"
                  strokeWidth="7"
                  strokeDasharray={264}
                  strokeDashoffset={264 - (264 * progressPercent) / 100}
                  strokeLinecap="round"
                  fill="transparent"
                />
              </svg>
              <div className="absolute inset-0 flex flex-col items-center justify-center">
                <span className="text-3xl sm:text-4xl font-black text-[#010101] font-mono tracking-tight leading-none">
                  {counter}
                </span>
                <span className="text-[10px] text-[#4D5660] font-bold uppercase tracking-wider mt-1">
                  Seconds
                </span>
              </div>
            </div>

            <div className="flex items-center gap-1.5 text-xs sm:text-[13px] font-extrabold text-[#010101] mb-1">
              <Loader2 className="w-3.5 h-3.5 animate-spin text-[#EE1D52]" />
              <span>Preparing {mediaType.toUpperCase()} Stream</span>
            </div>

            <p className="text-xs text-[#2F363D] max-w-xs leading-relaxed px-2">
              {settings.downloadPreparingText ||
                'Fetching original high quality stream and removing watermarks in background...'}
            </p>
          </div>
        ) : (
          <div className="flex flex-col items-center justify-center w-full max-w-sm animate-in fade-in duration-300">
            {/* Success icon */}
            <div className="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#ECFAFB] text-[#0A6C74] border border-[#69C9D0] flex items-center justify-center mb-3.5">
              {isDownloading ? (
                <Loader2 className="w-7 h-7 sm:w-8 sm:h-8 animate-spin text-[#EE1D52]" />
              ) : (
                <CheckCircle2 className="w-8 h-8 sm:w-9 sm:h-9 text-[#0A6C74]" />
              )}
            </div>

            <h3 className="text-lg sm:text-xl font-black text-[#010101] tracking-tight">
              {isDownloading ? 'Saving File...' : 'Download is Ready!'}
            </h3>

            <p className="text-xs text-[#2F363D] max-w-xs mt-1 leading-relaxed px-2">
              {downloadError
                ? downloadError
                : isDownloading
                ? 'Downloading stream directly to your device...'
                : hasTriggeredDownload
                ? 'Your file download has started. Click below if you want to save it again.'
                : 'Click the button below to save your clean file without watermarks.'}
            </p>

            {/* Primary Download Button */}
            <div className="mt-4 w-full max-w-xs flex flex-col gap-2">
              <button
                type="button"
                disabled={isDownloading || !downloadUrl}
                onClick={handleManualDownloadClick}
                className="w-full py-2.5 px-4 rounded-lg bg-[#EE1D52] hover:bg-[#D41445] active:scale-[0.98] disabled:opacity-60 text-[#FFFFFF] font-bold text-xs sm:text-[13px] flex items-center justify-center gap-2 transition-all cursor-pointer"
              >
                {isDownloading ? (
                  <>
                    <Loader2 className="w-4 h-4 animate-spin text-[#FFFFFF] shrink-0" />
                    <span>Downloading File...</span>
                  </>
                ) : (
                  <>
                    <Download className="w-4 h-4 text-[#FFFFFF] shrink-0" />
                    <span>
                      {hasTriggeredDownload
                        ? 'Download Again'
                        : mediaType === 'audio'
                        ? 'Download MP3 Audio'
                        : mediaType === 'avatar'
                        ? 'Download Avatar Image'
                        : 'Download HD Video Now'}
                    </span>
                  </>
                )}
              </button>

              <button
                type="button"
                onClick={onClose}
                className="w-full py-2 px-4 rounded-lg bg-[#010101] hover:bg-[#1D2126] active:scale-[0.98] text-[#FFFFFF] font-bold text-xs transition-all cursor-pointer"
              >
                Back to Profile Videos
              </button>
            </div>
          </div>
        )}

        {/* Modal Ad Slot */}
        <AdSlot placement="modal" className="w-full mt-3 mb-0 shrink-0" />
      </div>

      {/* Bottom Metadata Info Card */}
      <div className="w-full px-3.5 py-2.5 bg-[#F5F7F9] border-t border-[#DFE5EA] text-[11px] text-[#010101] flex items-center justify-between shrink-0">
        <div className="flex items-center gap-1.5 truncate max-w-[210px] sm:max-w-[260px] text-left">
          <Sparkles className="w-3.5 h-3.5 text-[#EE1D52] shrink-0" />
          <span className="truncate font-mono font-semibold text-[#010101]">
            {fileName || title || 'tiktok_clean_media'}
          </span>
        </div>
        <span className="font-extrabold text-[#010101] shrink-0 uppercase tracking-wider text-[10px] ml-2 bg-[#69C9D0] px-2 py-0.5 rounded">
          No Watermark HD
        </span>
      </div>
    </div>
  );
}

export default function DownloadCounterModal({
  isOpen,
  onClose,
  downloadUrl,
  fileName,
  mediaType,
  title,
}: DownloadCounterModalProps) {
  const [settings] = useSiteSettings();
  const initialSeconds = Math.max(1, settings.downloadCounterSeconds || 5);

  if (!isOpen) return null;

  return (
    <div
      onClick={onClose}
      className="fixed inset-0 z-50 bg-[#010101]/75 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4"
    >
      <ModalContent
        initialSeconds={initialSeconds}
        downloadUrl={downloadUrl}
        fileName={fileName}
        mediaType={mediaType}
        title={title}
        onClose={onClose}
        settings={settings}
      />
    </div>
  );
}