'use client';

import { useState, useRef, useEffect } from 'react';
import Link from 'next/link';
import { usePathname } from 'next/navigation';
import { ChevronDown, Menu, X, Check } from 'lucide-react';

const LANGUAGES = [
  { code: 'en', name: 'English', native: 'English', isDefault: true },
  { code: 'ar', name: 'Arabic', native: 'العربية' },
  { code: 'fr', name: 'French', native: 'Français' },
  { code: 'es', name: 'Spanish', native: 'Español' },
  { code: 'de', name: 'German', native: 'Deutsch' },
  { code: 'ru', name: 'Russian', native: 'Русский' },
  { code: 'zh', name: 'Chinese', native: '中文' },
  { code: 'pt', name: 'Portuguese', native: 'Português' },
  { code: 'he', name: 'Hebrew', native: 'עברית' },
  { code: 'hi', name: 'Hindu', native: 'हिन्दी' },
];

const TOOLS = [
  {
    href: '/tiktok-video-downloader',
    label: 'HD Video Downloader',
    desc: 'Download videos without watermark',
  },
  {
    href: '/tiktok-mp3-downloader',
    label: 'Audio MP3 Downloader',
    desc: 'Save original audio sound',
  },
  {
    href: '/tiktok-profile-viewer',
    label: 'Profile Viewer',
    desc: 'Check profiles and view count',
  },
  {
    href: '/tiktok-analytics',
    label: 'Viral Analytics',
    desc: 'See engagement and growth metrics',
  },
  {
    href: '/tiktok-story-downloader',
    label: 'Story Downloader',
    desc: 'Save stories before they expire',
  },
  {
    href: '/tiktok-photo-downloader',
    label: 'Photo & Slideshow',
    desc: 'Download carousel images in HD',
  },
  {
    href: '/tiktok-money-calculator',
    label: 'Money Calculator',
    desc: 'Estimate creator earnings & rates',
  },
  {
    href: '/tiktok-engagement-calculator',
    label: 'Engagement Calculator',
    desc: 'Calculate campaign engagement rate',
  },
  {
    href: '/tiktok-caption-generator',
    label: 'Caption Generator',
    desc: 'Generate viral hooks & hashtags',
  },
  {
    href: '/tiktok-watermark-remover',
    label: 'Watermark Remover',
    desc: 'Remove TikTok logo for Reels',
  },
];

export default function Navbar() {
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const [toolsDropdownOpen, setToolsDropdownOpen] = useState(false);
  const [langDropdownOpen, setLangDropdownOpen] = useState(false);
  const [selectedLang, setSelectedLang] = useState('English');
  const pathname = usePathname();

  const toolsRef = useRef<HTMLDivElement>(null);
  const langRef = useRef<HTMLDivElement>(null);

  const handleGoHome = () => {
    setMobileMenuOpen(false);
    setToolsDropdownOpen(false);
    setLangDropdownOpen(false);
    if (typeof window !== 'undefined') {
      window.dispatchEvent(new CustomEvent('tpv:reset-home'));
    }
  };

  useEffect(() => {
    function handleClickOutside(event: MouseEvent) {
      if (toolsRef.current && !toolsRef.current.contains(event.target as Node)) {
        setToolsDropdownOpen(false);
      }
      if (langRef.current && !langRef.current.contains(event.target as Node)) {
        setLangDropdownOpen(false);
      }
    }
    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  return (
    <header className="sticky top-0 z-40 w-full bg-[#FFFFFF]/95 backdrop-blur-md border-b border-[#DFE5EA] transition-all">
      <div className="max-w-[980px] mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-2.5">
        {/* Website Logo */}
        <Link
          href="/"
          onClick={handleGoHome}
          className="flex items-center gap-2 text-[#010101] select-none shrink-0 group"
        >
          <div className="w-7 h-7 rounded-lg overflow-hidden shrink-0 flex items-center justify-center bg-[#FFFFFF] border border-[#DFE5EA]">
            {/* eslint-disable-next-line @next/next/no-img-element */}
            <img
              src="/assets/aistudio/tik-profiles-viewer-logo_c4487561.png"
              alt="Tik Profiles Viewer Logo"
              className="w-full h-full object-contain"
            />
          </div>
          <div className="flex flex-col">
            <span className="font-extrabold text-[13px] sm:text-sm tracking-tight text-[#010101] group-hover:text-[#EE1D52] transition-colors leading-none">
              Tik Profiles Viewer
            </span>
            <span className="text-[10px] text-[#4D5660] font-semibold tracking-wide mt-0.5 leading-none">
              TikProfilesViewer.com
            </span>
          </div>
        </Link>

        {/* Nav Items aligned to the right */}
        <nav className="hidden lg:flex items-center gap-5 ml-auto">
          <Link
            href="/"
            onClick={handleGoHome}
            className={`text-[13px] font-semibold transition-colors ${
              pathname === '/'
                ? 'text-[#010101] underline underline-offset-4 decoration-2 decoration-[#EE1D52]'
                : 'text-[#2F363D] hover:text-[#EE1D52]'
            }`}
          >
            Home
          </Link>

          <Link
            href="/about-tiktok-profile-viewer"
            className={`text-[13px] font-semibold transition-colors ${
              pathname === '/about-tiktok-profile-viewer'
                ? 'text-[#010101] underline underline-offset-4 decoration-2 decoration-[#EE1D52]'
                : 'text-[#2F363D] hover:text-[#EE1D52]'
            }`}
          >
            About
          </Link>

          <Link
            href="/how-to-use-tiktok-profile-viewer"
            className={`text-[13px] font-semibold transition-colors ${
              pathname === '/how-to-use-tiktok-profile-viewer'
                ? 'text-[#010101] underline underline-offset-4 decoration-2 decoration-[#EE1D52]'
                : 'text-[#2F363D] hover:text-[#EE1D52]'
            }`}
          >
            How to use
          </Link>

          {/* Tools Dropdown */}
          <div className="relative" ref={toolsRef}>
            <button
              type="button"
              onClick={() => {
                setToolsDropdownOpen(!toolsDropdownOpen);
                setLangDropdownOpen(false);
              }}
              className={`text-[13px] font-semibold px-2.5 py-1 rounded-lg flex items-center gap-1 transition-colors cursor-pointer ${
                toolsDropdownOpen
                  ? 'bg-[#010101] text-[#FFFFFF]'
                  : 'text-[#2F363D] hover:text-[#010101] hover:bg-[#F0F4F7]'
              }`}
            >
              <span>Tools</span>
              <ChevronDown
                className={`w-3.5 h-3.5 transition-transform duration-200 ${
                  toolsDropdownOpen ? 'rotate-180' : ''
                }`}
              />
            </button>

            {toolsDropdownOpen && (
              <div className="absolute top-full left-0 mt-1.5 w-64 sm:w-72 max-h-[380px] overflow-y-auto rounded-xl bg-[#FFFFFF] border border-[#CBD5DF] shadow-lg p-1.5 z-50 flex flex-col gap-0.5">
                {TOOLS.map((tool) => (
                  <Link
                    key={tool.href}
                    href={tool.href}
                    onClick={() => setToolsDropdownOpen(false)}
                    className="px-2.5 py-2 rounded-lg hover:bg-[#FFF0F4] text-[#010101] hover:text-[#C4113F] transition-colors"
                  >
                    <div className="font-bold text-xs">{tool.label}</div>
                    <div className="text-[11px] text-[#4D5660] mt-0.5">{tool.desc}</div>
                  </Link>
                ))}
              </div>
            )}
          </div>

          {/* Languages Dropdown */}
          <div className="relative" ref={langRef}>
            <button
              type="button"
              onClick={() => {
                setLangDropdownOpen(!langDropdownOpen);
                setToolsDropdownOpen(false);
              }}
              className={`text-xs font-semibold px-2.5 py-1.5 rounded-lg flex items-center gap-1.5 transition-colors cursor-pointer border ${
                langDropdownOpen
                  ? 'bg-[#010101] border-[#010101] text-[#FFFFFF]'
                  : 'border-[#CBD5DF] bg-[#F5F7F9] text-[#010101] hover:border-[#69C9D0] hover:bg-[#ECFAFB]'
              }`}
            >
              <span>{selectedLang}</span>
              <ChevronDown
                className={`w-3.5 h-3.5 transition-transform duration-200 ${
                  langDropdownOpen ? 'rotate-180' : ''
                }`}
              />
            </button>

            {langDropdownOpen && (
              <div className="absolute top-full right-0 mt-1.5 w-48 rounded-xl bg-[#FFFFFF] border border-[#CBD5DF] shadow-lg p-1.5 z-50 flex flex-col gap-0.5">
                {LANGUAGES.map((lang) => {
                  const isSelected = selectedLang === lang.name;
                  return (
                    <button
                      key={lang.code}
                      type="button"
                      onClick={() => {
                        setSelectedLang(lang.name);
                        setLangDropdownOpen(false);
                      }}
                      className={`w-full px-2.5 py-1.5 rounded-lg text-xs flex items-center justify-between text-left transition-colors cursor-pointer ${
                        isSelected
                          ? 'bg-[#ECFAFB] text-[#010101] font-bold border border-[#69C9D0]/60'
                          : 'text-[#2F363D] hover:bg-[#F0F4F7] hover:text-[#010101]'
                      }`}
                    >
                      <span>
                        {lang.name}{' '}
                        <span className="text-[#4D5660] font-normal">
                          ({lang.native})
                        </span>
                      </span>
                      {isSelected && <Check className="w-3.5 h-3.5 text-[#EE1D52]" />}
                    </button>
                  );
                })}
              </div>
            )}
          </div>
        </nav>

        {/* Mobile Actions: Language & Hamburger */}
        <div className="flex lg:hidden items-center gap-1.5">
          <button
            type="button"
            onClick={() => {
              setLangDropdownOpen(!langDropdownOpen);
              setMobileMenuOpen(false);
            }}
            className="px-2.5 py-1 rounded-lg border border-[#CBD5DF] bg-[#F5F7F9] text-xs font-semibold text-[#010101] flex items-center gap-1 cursor-pointer hover:bg-[#ECFAFB] hover:border-[#69C9D0]"
          >
            <span>{selectedLang}</span>
            <ChevronDown className="w-3 h-3 text-[#4D5660]" />
          </button>

          <button
            type="button"
            onClick={() => {
              setMobileMenuOpen(!mobileMenuOpen);
              setLangDropdownOpen(false);
            }}
            className="p-1.5 rounded-lg bg-[#F5F7F9] border border-[#CBD5DF] text-[#010101] hover:bg-[#E6ECF0] transition-colors cursor-pointer"
            aria-label="Toggle Menu"
          >
            {mobileMenuOpen ? <X className="w-4 h-4" /> : <Menu className="w-4 h-4" />}
          </button>
        </div>
      </div>

      {/* Mobile Language Dropdown popup */}
      {langDropdownOpen && (
        <div className="lg:hidden border-b border-[#DFE5EA] bg-[#FFFFFF] px-4 py-2.5 shadow-md">
          <p className="text-[11px] font-bold text-[#4D5660] uppercase tracking-wider mb-1.5">
            Select Language
          </p>
          <div className="grid grid-cols-2 gap-1.5">
            {LANGUAGES.map((lang) => (
              <button
                key={lang.code}
                type="button"
                onClick={() => {
                  setSelectedLang(lang.name);
                  setLangDropdownOpen(false);
                }}
                className={`px-2.5 py-1.5 rounded-lg text-xs text-left flex items-center justify-between border ${
                  selectedLang === lang.name
                    ? 'bg-[#EE1D52] border-[#EE1D52] text-[#FFFFFF] font-semibold'
                    : 'bg-[#F5F7F9] border-[#DFE5EA] text-[#010101] hover:bg-[#ECFAFB]'
                }`}
              >
                <span>{lang.name}</span>
                {selectedLang === lang.name && <Check className="w-3 h-3 text-[#FFFFFF]" />}
              </button>
            ))}
          </div>
        </div>
      )}

      {/* Mobile Navigation Drawer */}
      {mobileMenuOpen && (
        <div className="lg:hidden border-b border-[#DFE5EA] bg-[#FFFFFF] px-4 py-3 flex flex-col gap-1.5 shadow-md max-h-[80vh] overflow-y-auto">
          <Link
            href="/"
            onClick={handleGoHome}
            className="px-2.5 py-1.5 rounded-lg text-[13px] font-semibold text-[#010101] hover:bg-[#FFF0F4] hover:text-[#C4113F]"
          >
            Home
          </Link>
          <Link
            href="/about-tiktok-profile-viewer"
            onClick={() => setMobileMenuOpen(false)}
            className="px-2.5 py-1.5 rounded-lg text-[13px] font-semibold text-[#010101] hover:bg-[#FFF0F4] hover:text-[#C4113F]"
          >
            About
          </Link>
          <Link
            href="/how-to-use-tiktok-profile-viewer"
            onClick={() => setMobileMenuOpen(false)}
            className="px-2.5 py-1.5 rounded-lg text-[13px] font-semibold text-[#010101] hover:bg-[#FFF0F4] hover:text-[#C4113F]"
          >
            How to use
          </Link>
          <Link
            href="/creators"
            onClick={() => setMobileMenuOpen(false)}
            className="px-2.5 py-1.5 rounded-lg text-[13px] font-semibold text-[#010101] hover:bg-[#FFF0F4] hover:text-[#C4113F]"
          >
            Browse Top Creators
          </Link>

          <div className="pt-2 border-t border-[#DFE5EA]">
            <span className="text-[11px] font-bold text-[#4D5660] uppercase tracking-wider block px-2.5 mb-1">
              Tools
            </span>
            <div className="flex flex-col gap-0.5">
              {TOOLS.map((tool) => (
                <Link
                  key={tool.href}
                  href={tool.href}
                  onClick={() => setMobileMenuOpen(false)}
                  className="px-2.5 py-1.5 rounded-lg text-xs font-semibold text-[#010101] hover:bg-[#FFF0F4] hover:text-[#C4113F] flex items-center justify-between gap-2"
                >
                  <span>{tool.label}</span>
                  <span className="text-[11px] font-normal text-[#4D5660] truncate">{tool.desc}</span>
                </Link>
              ))}
            </div>
          </div>
        </div>
      )}
    </header>
  );
}